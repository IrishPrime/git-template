#!/usr/bin/env bash

# Add the Jira issue to the beginning of your commit message. Assumes branch
# names of the following forms:
# WKF-1234-a-short-description
# WKF-1234/slashes-are-fine-too
# prefix/XFIL-5678-a-different-description
# hotfix/user/XFIL-5678/multiple-slashes-and-prefixes

ISSUE=$(git symbolic-ref --short HEAD | grep -o '[[:alpha:]]\+-[[:digit:]]\+' | head -1)

if [ -n "$ISSUE" ]; then
	sed -i.bak -e "1s/^$/$ISSUE /" $1
fi
